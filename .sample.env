# Main API URL for GitHub Integration
MAIN_API_URL=https://api.softbridgelabs.in

# Hosting Domain
SBLAB_DOMAIN=sblab.xyz

# Cloudflare Configuration (for Worker deployment if using wrangler directly via CI/CD)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
CLOUDFLARE_ZONE_ID=your_zone_id

# Auth Secret (if any additional JWT secrets are used alongside Firebase)
AUTH_SECRET=your_auth_secret
